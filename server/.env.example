# Server Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Database (SQLite for zero-config local dev; swap to postgresql://... for prod)
DATABASE_URL="file:./dev.db"

# Solana Configuration
# Toggle between 'devnet' and 'mainnet-beta'
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Escrow Vault Keypair (Base58-encoded secret key or JSON byte array [1,2,...])
# Generate one via: node -e "const {Keypair}=require('@solana/web3.js');const k=Keypair.generate();console.log('PUB:',k.publicKey.toBase58());console.log('PRIV:',JSON.stringify(Array.from(k.secretKey)))"
ESCROW_PRIVATE_KEY=

# Developer Treasury Wallet (receives the house rake)
DEV_TREASURY_WALLET=

# House Rake Configuration
# RAKE_BPS: 500 = 5% (500 basis points out of 10000)
RAKE_BPS=500
# RAKE_MODE: 'entry' (deducted on buy-in) or 'cashout' (deducted on cash-out)
RAKE_MODE=entry
